# توکن از @BotFather
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# آیدی عددی تلگرام ادمین(های) ثابت، با کاما جدا شود (مثال: 111111111,222222222)
# این‌ها همیشه ادمین‌اند و از داخل ربات هم قابل حذف نیستند.
# ادمین‌های بیشتر را می‌توانید از داخل پنل («👤 مدیریت ادمین‌ها») هم اضافه کنید -
# نیازی به ویرایش این فایل و ری‌استارت کردن ربات برای هر ادمین جدید نیست.
ADMIN_IDS=8392724333

# اختیاری - مسیر فایل دیتابیس (پیش‌فرض کافیست)
DATABASE_PATH=quiz.db

# اختیاری - هر چند ثانیه پیام تایمر سؤال ویرایش شود
TIMER_UPDATE_INTERVAL=5
LOG_LEVEL=INFO
